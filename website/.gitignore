node_modules/
dist/
.vite/

# 站点数据都是生成物：benchData.js 由 vite 配置在构建前生成，
# data/history.json 由 CI 从 gh-pages 取回，public/data/ 是随站点发布的副本
src/lib/benchData.js
data/
public/data/

.DS_Store
*.log

# 仓库根 .gitignore 全局忽略 *.lock，但 CI 用 bun install --frozen-lockfile，
# 锁文件必须入库才能在构建机上复现同一套 vite/svelte 版本
!bun.lock
